+static void test_anthropic_deferred_tool_references(void) {
+    const char *schemas =
+        "{\"name\":\"ToolSearch\",\"input_schema\":{\"type\":\"object\"}}\n"
+        "{\"name\":\"read_file\",\"description\":\"Read a file\","
+        "\"defer_loading\":true,\"input_schema\":{\"type\":\"object\","
+        "\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}}\n";
+    const char *name_keys[] = {"name", "tool_name"};
+    for (size_t i = 0; i < 2; i++) {
+        buf json = {0};
+        buf_printf(&json,
+            "[{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\","
+            "\"id\":\"search1\",\"name\":\"ToolSearch\",\"input\":{}}]},"
+            "{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\","
+            "\"tool_use_id\":\"search1\",\"content\":[{\"type\":\"text\",\"text\":\"found\"},"
+            "{\"type\":\"tool_reference\",\"%s\":\"read_file\"}]}]}]", name_keys[i]);
+        const char *p = json.ptr;
+        chat_msgs msgs = {0};
+        TEST_ASSERT(parse_anthropic_messages(&p, &msgs, schemas));
+        char *prompt = render_chat_prompt_text_for_syntax(
+            SERVER_MODEL_SYNTAX_GLM, &msgs, schemas, NULL, DS4_THINK_HIGH);
+        const char *observation = strstr(prompt, "<|observation|>");
+        const char *definition = strstr(prompt, "\"name\": \"read_file\"");
+        TEST_ASSERT(observation && definition && definition > observation);
+        TEST_ASSERT(definition && strstr(definition, "\"required\":[\"path\"]"));
+        TEST_ASSERT(!strstr(prompt, "\"defer_loading\""));
+        TEST_ASSERT(strstr(prompt, "<|assistant|><think>"));
+        free(prompt);
+        chat_msgs_free(&msgs);
+        buf_free(&json);
+    }
+    /* Missing catalog entries must fail, not disappear from the prompt. */
+    const char *unknown =
+        "[{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\","
+        "\"tool_use_id\":\"s\",\"content\":[{\"type\":\"tool_reference\","
+        "\"tool_name\":\"not_in_catalog\"}]}]}]";
+    chat_msgs msgs = {0};
+    TEST_ASSERT(!parse_anthropic_messages(&unknown, &msgs, schemas));
+    chat_msgs_free(&msgs);
+    request req;
+    char error[160] = {0};
+    TEST_ASSERT(!parse_anthropic_request(NULL, NULL,
+        "{\"messages\":[],\"tool_choice\":{\"type\":\"any\"}}",
+        1, 4096, &req, error, sizeof(error)));
+}
