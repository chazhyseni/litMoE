+/* The scheduler mutex is never held over prefill. Include accepted clients
+ * still parsing/awaiting a job, and slots finishing checkpoint housekeeping.
+ * A closed socket alone therefore cannot acknowledge model quiescence. */
+static void send_litmoe_status(server *s, int fd) {
+    int queued = 0, busy = 0;
+    pthread_mutex_lock(&s->mu);
+    for (job *j = s->head; j; j = j->next) queued++;
+    for (int i = 0; i < s->slot_count; i++) busy += s->slots[i].busy;
+    int active = s->clients - 1 - queued;
+    if (active < busy) active = busy;
+    pthread_mutex_unlock(&s->mu);
+    buf body = {0};
+    buf_printf(&body,
+        "{\"status\":\"ok\",\"active_requests\":%d,\"queued_requests\":%d,"
+        "\"context_window\":%d,\"capabilities\":{\"native_messages\":true,"
+        "\"tool_search\":true,\"count_tokens\":true,\"prompt_cache\":\"backend\","
+        "\"cancellation\":\"prefill-chunked\"}}",
+        active, queued, s->ctx_size);
+    http_response(fd, s->enable_cors, 200, "application/json", body.ptr);
+    buf_free(&body);
+}
