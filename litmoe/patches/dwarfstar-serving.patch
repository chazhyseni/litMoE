+static void test_litmoe_status_waits_for_native_housekeeping(void) {
+    server s;
+    test_cancel_server_init(&s);
+    server_slot slot = {0};
+    s.slots = &slot;
+    s.slot_count = 1;
+    s.ctx_size = 8192;
+    job queued = {0};
+    for (int state = 0; state < 4; state++) {
+        int sv[2] = {-1, -1};
+        TEST_ASSERT(socketpair(AF_UNIX, SOCK_STREAM, 0, sv) == 0);
+        if (sv[0] < 0) break;
+        /* Parsing, disconnected-but-busy, queued, then fully idle. */
+        s.clients = state == 0 || state == 2 ? 2 : 1;
+        slot.busy = state == 1;
+        s.head = state == 2 ? &queued : NULL;
+        send_litmoe_status(&s, sv[0]);
+        shutdown(sv[0], SHUT_WR);
+        char *out = read_socket_text(sv[1]);
+        TEST_ASSERT(strstr(out, state < 2 ? "\"active_requests\":1" : "\"active_requests\":0"));
+        TEST_ASSERT(strstr(out, state == 2 ? "\"queued_requests\":1" : "\"queued_requests\":0"));
+        free(out);
+        close(sv[0]);
+        close(sv[1]);
+    }
+    test_cancel_server_destroy(&s);
+}
