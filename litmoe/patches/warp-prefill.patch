+++ b/tests/test_mvq.c
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/* Exact Q4 range arithmetic, including odd rows and generic-path groups. */
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "../src/simd.h"
+
+void waste_mvq_rows_f32(int b, int e, void *p);
+
+int main(void)
+{
+#if defined(__ARM_NEON) || defined(__aarch64__)
+    enum { ROWS = 17, MAX_IN = 256, MAX_GROUPS = 8 };
+    const int groups[] = {32, 48, 64, 128};
+    const int inputs[] = {32, 64, 96, 128, 256};
+    int8_t weights[ROWS * MAX_IN];
+    uint16_t scales[ROWS * MAX_GROUPS];
+    float x[MAX_IN], y[ROWS], expected[ROWS];
+    for (int i = 0; i < MAX_IN; i++) x[i] = (float)((i * 13) % 31 - 15) / 11.0f;
+    for (int gi = 0; gi < 4; gi++) for (int ni = 0; ni < 5; ni++) {
+        const int g = groups[gi], in = inputs[ni], ng = (in + g - 1) / g;
+        const size_t rowbytes = (size_t)ng * g / 2;
+        for (int r = 0; r < ROWS; r++) {
+            for (size_t j = 0; j < rowbytes; j++)
+                weights[r * rowbytes + j] = (int8_t)((r * 19 + j * 37) & 255);
+            float total = 0;
+            for (int k = 0; k < ng; k++) {
+                const int exponent = (r + k) % 3;
+                scales[r * ng + k] = (uint16_t)(0x3800 + 0x400 * exponent);
+                const float scale = exponent == 0 ? 0.5f : exponent == 1 ? 1.0f : 2.0f;
+                float lanes[4] = {0, 0, 0, 0};
+                const int limit = in - k * g < g ? in - k * g : g;
+                for (int j = 0; j < limit; j++) {
+                    const uint8_t packed = (uint8_t)weights[r * rowbytes + (k * g + j) / 2];
+                    const int q = ((j & 1) ? packed >> 4 : packed & 15) - 8;
+                    lanes[j & 3] = fmaf((float)q, x[k * g + j], lanes[j & 3]);
+                }
+                total += scale * ((lanes[0] + lanes[1]) + (lanes[2] + lanes[3]));
+            }
+            expected[r] = total;
+        }
+        for (int b = 0; b < ROWS; b++) for (int e = b; e <= ROWS; e++) {
+            for (int r = 0; r < ROWS; r++) y[r] = 12345.0f;
+            mvq_arg a = {y, weights, scales, NULL, x, in, ng, g, 4, rowbytes};
+            waste_mvq_rows_f32(b, e, &a);
+            for (int r = 0; r < ROWS; r++) {
+                const float want = r >= b && r < e ? expected[r] : 12345.0f;
+                if (memcmp(&y[r], &want, sizeof want)) {
+                    fprintf(stderr, "Q4 mismatch: group=%d in=%d range=%d:%d row=%d got=%.9g want=%.9g\n",
+                            g, in, b, e, r, y[r], want);
+                    return 1;
+                }
+            }
+        }
+    }
+    puts("Q4 exact range arithmetic passed");
+#else
+    puts("Q4 paired-row kernel is ARM-only; generic kernels use the model oracle checks");
+    return 77;
+#endif
+    return 0;
+}
