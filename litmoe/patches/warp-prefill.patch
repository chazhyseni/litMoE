+/* Keep each row's FMA order, but expose two independent dependency chains.
+ * Pairing rows also reuses the activation loads; no activation quantization
+ * or extra weight representation is needed. */
+static inline float32x4_t mvq4_acc32(float32x4_t sum, uint8x16_t by,
+                                   const float *x)
+{
+    const int8x16_t lo = vsubq_s8(
+        vreinterpretq_s8_u8(vandq_u8(by, vdupq_n_u8(15))), vdupq_n_s8(8));
+    const int8x16_t hi = vsubq_s8(
+        vreinterpretq_s8_u8(vshrq_n_u8(by, 4)), vdupq_n_s8(8));
+    const int8x16x2_t z = vzipq_s8(lo, hi);
+    for (int h = 0; h < 2; h++) {
+        const int16x8_t l16 = vmovl_s8(vget_low_s8(z.val[h]));
+        const int16x8_t h16 = vmovl_s8(vget_high_s8(z.val[h]));
+        sum = vfmaq_f32(sum, vcvtq_f32_s32(vmovl_s16(vget_low_s16(l16))),
+                       vld1q_f32(x + 16 * h));
+        sum = vfmaq_f32(sum, vcvtq_f32_s32(vmovl_s16(vget_high_s16(l16))),
+                       vld1q_f32(x + 16 * h + 4));
+        sum = vfmaq_f32(sum, vcvtq_f32_s32(vmovl_s16(vget_low_s16(h16))),
+                       vld1q_f32(x + 16 * h + 8));
+        sum = vfmaq_f32(sum, vcvtq_f32_s32(vmovl_s16(vget_high_s16(h16))),
+                       vld1q_f32(x + 16 * h + 12));
+    }
+    return sum;
+}
+
+static void mvq4_rows_pair(int b, int e, const mvq_arg *a)
+{
+    const int g = a->group, ng = a->ng;
+    const float *x = (const float *)a->xs;
+    int o = b;
+    for (; o + 1 < e; o += 2) {
+        const uint8_t *r0 = (const uint8_t *)a->W + (size_t)o * a->rowbytes;
+        const uint8_t *r1 = r0 + a->rowbytes;
+        const uint16_t *w0 = a->ws + (size_t)o * ng, *w1 = w0 + ng;
+        float y0 = 0, y1 = 0;
+        for (int k = 0; k < ng; k++) {
+            float32x4_t s0 = vdupq_n_f32(0), s1 = vdupq_n_f32(0);
+            for (int j = 0; j < g; j += 32) {
+                const size_t off = ((size_t)k * g + j) / 2;
+                const float *xx = x + (size_t)k * g + j;
+                s0 = mvq4_acc32(s0, vld1q_u8(r0 + off), xx);
+                s1 = mvq4_acc32(s1, vld1q_u8(r1 + off), xx);
+            }
+            y0 += f16_to_f32(w0[k]) * vaddvq_f32(s0);
+            y1 += f16_to_f32(w1[k]) * vaddvq_f32(s1);
+        }
+        a->y[o] = y0;
+        a->y[o + 1] = y1;
+    }
+    if (o < e) {
+        const uint8_t *row = (const uint8_t *)a->W + (size_t)o * a->rowbytes;
+        const uint16_t *ws = a->ws + (size_t)o * ng;
+        float y = 0;
+        for (int k = 0; k < ng; k++) {
+            float32x4_t sum = vdupq_n_f32(0);
+            for (int j = 0; j < g; j += 32)
+                sum = mvq4_acc32(sum,
+                    vld1q_u8(row + ((size_t)k * g + j) / 2),
+                    x + (size_t)k * g + j);
+            y += f16_to_f32(ws[k]) * vaddvq_f32(sum);
+        }
+        a->y[o] = y;
+    }
+}
