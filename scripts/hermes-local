#!/usr/bin/env bash
# hermes-local — run Hermes Agent against a litmoe gateway for ONE session,
# without changing the model/provider your normal `hermes` uses.
#
# Uses per-invocation provider flags instead of changing ~/.hermes/config.yaml.
# Endpoint and credential variables apply only to the child process:
#
# For authenticated gateways, pass --model and --key (or LITMOE_API_KEY).
# Automatic model discovery does not send an authorization header.
#
#   hermes chat --provider custom -m <model>     with CUSTOM_BASE_URL,
#     OPENAI_BASE_URL and OPENAI_API_KEY set only in this process's environment
#
# Usage:
#   hermes-local [--gateway URL] [--model ID] [--key KEY] [hermes chat args...]
#
#   hermes-local                       # interactive chat with the first gateway model
#   hermes-local -q "summarize x"      # one query
#   hermes-local --model gpt-oss-120b
#
# Reverting: run `hermes` normally — its config.yaml was never modified.
#
# For a persistent-but-separate setup use a Hermes profile instead (see
# docs/HARNESSES.md): `hermes profile create litmoe` then configure the model
# inside that profile; your default profile stays untouched.
set -euo pipefail

GATEWAY="${LITMOE_GATEWAY:-http://127.0.0.1:8090}"
MODEL="${LITMOE_MODEL:-}"
KEY="${LITMOE_API_KEY:-litmoe}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --gateway) GATEWAY="$2"; shift 2 ;;
    --model)   MODEL="$2";   shift 2 ;;
    --key)     KEY="$2";     shift 2 ;;
    -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --) shift; break ;;
    *) break ;;
  esac
done

command -v hermes >/dev/null 2>&1 || { echo "hermes-local: 'hermes' not on PATH" >&2; exit 127; }

if ! curl -sf --max-time 3 "$GATEWAY/health" >/dev/null 2>&1; then
  echo "hermes-local: litmoe gateway not reachable at $GATEWAY (start it with: litmoe serve)" >&2
  exit 1
fi
if [[ -z "$MODEL" ]]; then
  MODEL="$(curl -sf --max-time 5 "$GATEWAY/v1/models" \
    | python3 -c 'import sys,json; d=json.load(sys.stdin)["data"]; m=[x["id"] for x in d if not x.get("alias_of")]; print(m[0] if m else "")' 2>/dev/null || true)"
  [[ -n "$MODEL" ]] || { echo "hermes-local: gateway has no models loaded" >&2; exit 1; }
fi

exec env \
  CUSTOM_BASE_URL="$GATEWAY/v1" \
  OPENAI_BASE_URL="$GATEWAY/v1" \
  OPENAI_API_KEY="$KEY" \
  hermes chat --provider custom -m "$MODEL" "$@"
