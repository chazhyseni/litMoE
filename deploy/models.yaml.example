# litmoe models.yaml — Docker deployment example
# Copy to deploy/models.yaml and edit. Weights live in ~/.litmoe/models on the
# host, mounted read-only at /models in the container.
#
# Gateway listens on 8000 inside the compose network; the host sees it on
# 127.0.0.1:8000 only (no auth by default → never expose to the LAN).
# Open WebUI is published on :8080.

host: 0.0.0.0
port: 8000
api_key: null

models:
  # Default: Gemma-4-26B-A4B (MoE, 4B active, 256K ctx, vision). Download on the host:
  #   litmoe install --model gemma-4-26b-a4b --engine none
  - id: gemma-4-26b-a4b
    engine: llamacpp
    model_path: /models/gemma-4-26b-a4b/UD-Q4_K_XL/gemma-4-26B-A4B-it-UD-Q4_K_XL.gguf
    n_gpu_layers: 0            # CPU image
    n_ctx: 262144              # lowered automatically if the container has less RAM
    extra_args: ["--mmproj", "/models/gemma-4-26b-a4b/UD-Q4_K_XL/mmproj-F16.gguf"]
    aliases:                   # Anthropic model names Claude Code may send
      - claude-sonnet-4-5
      - claude-haiku-4-5
      - claude-opus-4-1

  # Qwen3.6-35B-A3B — 3B active; strong coding. 22 GB.
  # - id: qwen3.6-35b-a3b
  #   engine: llamacpp
  #   model_path: /models/qwen3.6-35b-a3b/UD-Q4_K_XL/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
  #   n_gpu_layers: 0
  #   n_ctx: 262144

  # Empty list = gateway starts with no models loaded.
